# mpv precompiled runtime stays on disk for dev and Tauri resource packaging.
# Track only provenance/notices/licenses; never player binaries or runtime data.
/tools/mpv/*
!/tools/mpv/Copyright
!/tools/mpv/LICENSE.GPL
!/tools/mpv/LICENSE.LGPL
!/tools/mpv/THIRD-PARTY-NOTICES.md
!/tools/mpv/source-manifest.json
!/tools/mpv/licenses/

# Reviewed historical text only; release binaries remain excluded everywhere.
!/docs/history/workspace-20261009/releases/
!/docs/history/workspace-20261009/releases/**/
!/docs/history/workspace-20261009/releases/**/*.md

# R1.5.1 contains sanitized review text/source deltas only, never build artifacts.
!qa/
qa/*
!qa/release/
qa/release/*
!qa/release/R1.5.1/
!qa/release/R1.5.1/*.md
!qa/release/R1.5.1/*.py
!qa/release/R1.5.1/.gitignore
!qa/release/R1.5.1/.gitattributes
!qa/release/R1.5.1/BUILD-MODE-VERIFICATION.json
!qa/release/R1.5.1/UPDATED-SOURCE-CANDIDATE-MANIFEST.json
!qa/release/R1.5.1/SOURCE-CANDIDATE-DELTA.zip
!qa/release/R1.5.1/evidence/
!qa/release/R1.5.1/evidence/*.json
!qa/release/R1.5.1/evidence/*.log

# R1.6 sanitized implementation, source-only exports and verification receipts.
!qa/release/R1.6/
!qa/release/R1.6/**
qa/release/R1.6/__pycache__/
qa/release/R1.6/*.pyc
!/tools/mpv/RECIPIENT-README.md
!/tools/mpv/LICENSE-MIRY
!/tools/mpv/LICENSE-SCOPE.json
!/tools/mpv/THIRD-PARTY-EXCEPTIONS.md
!/tools/mpv/compliance/
!/tools/mpv/compliance/**
