# mpv precompiled runtime stays on disk for dev and Tauri resource packaging.
# Track only provenance/notices/licenses; never player binaries or runtime data.
/tools/mpv/*
!/tools/mpv/Copyright
!/tools/mpv/LICENSE.GPL
!/tools/mpv/LICENSE.LGPL
!/tools/mpv/THIRD-PARTY-NOTICES.md
!/tools/mpv/source-manifest.json
!/tools/mpv/licenses/

# Reviewed historical text only; release binaries remain excluded everywhere.
!/docs/history/workspace-20261009/releases/
!/docs/history/workspace-20261009/releases/**/
!/docs/history/workspace-20261009/releases/**/*.md
